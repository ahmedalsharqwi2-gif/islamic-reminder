      "parameters": {"jsCode":"const meta = $('Generate Reminder').first().json;\nconst videos = Array.isArray($json.videos) ? $json.videos : [];\nif (!videos.length) throw new Error('Pexels returned no videos for the selected query.');\nconst ranked = videos.map(v => {\n  const files = Array.isArray(v.video_files) ? v.video_files : [];\n  const candidates = files.filter(f => f.link && f.file_type === 'video/mp4').sort((a,b) => (b.width*b.height)-(a.width*a.height));\n  const portrait = candidates.find(f => f.height >= f.width) || candidates[0];\n  return {v, file: portrait};\n}).filter(x => x.file);\nif (!ranked.length) throw new Error('Pexels returned no downloadable MP4 files.');\nconst chosen = ranked[Math.floor(Math.random() * Math.min(ranked.length, 8))];\nconst now = new Date();\nconst stamp = now.toISOString().replace(/[-:TZ.]/g,'').slice(0,14);\nconst job_tag = `reminder-${stamp}-${Math.random().toString(36).slice(2,8)}`;\nreturn [{json:{...meta,pexels_video_id:chosen.v.id,video_url:chosen.file.link,video_width:chosen.file.width,video_height:chosen.file.height,job_tag}}];"},
